# ==============================================================================
# Cấu hình Cơ sở dữ liệu PostgreSQL
# ==============================================================================
# Trường hợp 1: Chạy trực tiếp trên máy host (Local Dev với Maven / IDE):
# DB_URL=jdbc:postgresql://localhost:5432/smartbuild_db

# Trường hợp 2: Chạy trong môi trường Docker Compose (trỏ tới service "postgres"):
DB_URL=jdbc:postgresql://postgres:5432/smartbuild_db

DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==============================================================================
# Cấu hình JWT (Yêu cầu tối thiểu 256-bit = 32 ký tự ASCII trở lên)
# ==============================================================================
JWT_SECRET=smartbuildpc_jwt_secret_key_minimum_256_bits_length_for_security_compliance

# ==============================================================================
# Cấu hình CORS (Danh sách các Origin Frontend được phép gọi API)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
